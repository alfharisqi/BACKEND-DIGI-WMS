{
  "name": "digiwms-backend",
  "version": "1.0.0",
  "description": "DIGI WMS Lightweight Backend API (Fastify + PostgreSQL + EMQX MQTT)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --module commonjs --moduleResolution node",
    "start": "node dist/server.js",
    "test:orang1": "node --import tsx --test tests/orang1.test.ts",
    "test:orang1:runtime": "node --test tests/start-built.test.mjs",
    "test:orang1:mqtt": "node --import tsx --test tests/mqtt-transport.test.ts",
    "test:orang1:audit": "node --import tsx --test tests/orang1-audit-migration.test.ts",
    "test:orang1:supabase": "node --import tsx --test tests/supabase-contract.test.ts",
    "test:orang1:emqx": "node --import tsx --test tests/emqx-qa.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.7.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
