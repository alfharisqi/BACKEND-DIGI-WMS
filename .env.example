# ==========================================================
# KONFIGURASI LINGKUNGAN (ENVIRONMENT) DIGI WMS - TAHAP 1
# ==========================================================

# 1. Server Backend API
PORT=5000
NODE_ENV=development
JWT_SECRET=digiwms-rahasia-super-aman-2026

# 2. Database PostgreSQL (Docker Port 5432)
POSTGRES_USER=digiwms
POSTGRES_PASSWORD=digiwms_pass
POSTGRES_DB=digiwms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://digiwms:digiwms_pass@localhost:5432/digiwms_db

# 3. Broker EMQX MQTT
# - Port 1883: Koneksi TCP untuk Backend Node.js, Gate Service & Reader Hardware
# - Port 8083: Koneksi MQTT over WebSocket untuk Browser React.js (Live Updating)
# - Port 18083: Dashboard Web EMQX (Default login: admin / public)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_WS_URL=ws://localhost:8083/mqtt
MQTT_CLIENT_ID_PREFIX=digiwms_server_

# 4. Konfigurasi RFID UHF & Gate Threshold
RFID_FREQ_MHZ=920-923
GATE_RSSI_THRESHOLD_DBM=-65
GATE_DEDUP_WINDOW_SEC=5
